<?xml version="1.0" encoding="utf-8"?>
<!-- Left-edge accent strip for the card: periwinkle-to-teal gradient,
     signaling the app's identity without repeating "NUTRITION" as text
     now that the OS-drawn notification header already shows it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="@color/lockscreen_accent_periwinkle"
        android:endColor="@color/lockscreen_accent_teal"/>
    <corners
        android:topLeftRadius="20dp"
        android:bottomLeftRadius="20dp"
        android:topRightRadius="0dp"
        android:bottomRightRadius="0dp"/>
</shape>
